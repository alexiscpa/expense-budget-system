// Expense Budget System - Prisma schema
// Money fields use Decimal(18,2) to avoid floating point rounding errors.
// This schema is the source of truth for the data model described in
// docs/requirements-traceability.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (PgBouncer) - used by the running application.
  url       = env("DATABASE_URL")
  // Direct/unpooled connection - required by Prisma Migrate.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  SYSTEM_ADMIN
  BUDGET_OWNER
  DEPARTMENT_EDITOR
  DEPARTMENT_REVIEWER
  FINANCE_REVIEWER
  FINANCE_APPROVER
  READ_ONLY
  AUDITOR
}

enum DeptClass {
  P // 生產
  R // 研發
  S // 營業
  M // 管理
  UNCLASSIFIED // 待確認，不計入四大類彙總，僅計入總計
}

// Domestic vs. overseas site, independent of DeptClass (an overseas unit is
// still classified S/M/etc per its actual business function - see
// docs/stage2b1-department-reconciliation.md; this flag exists purely so the
// distinction can be queried/displayed without re-deriving it from the name).
enum DomesticOverseas {
  DOMESTIC
  OVERSEAS
}

// Lifecycle of one department-scoped invitation (see Invitation model).
// PENDING is the only state a token can still be redeemed from; every other
// state is terminal - acceptInvitation() must never transition out of
// ACCEPTED/EXPIRED/LOCKED/REVOKED.
enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED // set lazily when the 21-day window has passed - see isInvitationExpired()
  LOCKED // 5 failed token attempts reached
  REVOKED // an admin explicitly revoked it before it was ever accepted
}

// Which chart of accounts an Account row belongs to. Exists specifically so
// account SELECTION (which accounts are "applicable" when a brand-new
// BudgetVersion draft is created for a department) never has to guess from
// an incidental field like sourceSeq or from the account name/code shape -
// see getBudgetAccountsForDepartment in src/lib/budget/accountSelection.ts,
// the single place every BudgetLine-creating entry point gets its account
// set from.
enum AccountCatalog {
  // The canonical, all-four-class M/S/R/P chart of accounts (62/62/62/52),
  // sourced from 2025費用總表-第一版(20241122).xlsx - the same workbook the
  // Stage 2B-1/2B-2 department manifest itself is built from. Used for
  // EVERY Stage 2B-2 department's new BudgetVersion draft, 17203 財務管理處
  // included, regardless of forceEditable/isTestData/role/API entry point.
  OFFICIAL
  // 17203's own separate, one-off manual-demo chart of accounts (62
  // M-class-only items, imported from a different, unrelated file -
  // "2026年度費用預算V2--財務.xlsx" - for a hand-built walkthrough of the
  // budget screen). Never selected for a NEW draft by
  // getBudgetAccountsForDepartment; existing historical BudgetLine rows
  // that already reference a FINANCE_DEMO account are never touched or
  // migrated - this tag only changes which accounts a NEW draft picks up.
  FINANCE_DEMO
}

enum AccountEntryType {
  FORMULA // 公式自動計算
  NOT_BUDGETED // 不編列，固定為 0
  DEPARTMENT_INPUT // 部門主管參考前期金額自行填列
}

enum AccountCommonCategory {
  PERSONNEL // 人事費用
  OFFICE // 辦公費用
  SG_AND_A // 銷管費用
  OTHER // 其他費用
}

enum BudgetStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  RETURNED
  APPROVED
  LOCKED
  ADJUSTMENT_PENDING
  ADJUSTED
  REJECTED
}

enum FormulaStatus {
  NOT_APPLICABLE // 非公式科目
  CONFIGURED
  NOT_CONFIGURED // 公式或薪資資料來源尚未設定，畫面顯示「尚未設定」，禁止送審
}

enum ImportEntityType {
  ACCOUNT
  DEPARTMENT
  USER
  BUDGET_LINES
}

enum ImportBatchStatus {
  PENDING
  VALIDATED
  FAILED
  COMMITTED
  ROLLED_BACK
}

enum MemoryType {
  PRIOR_YEAR_APPROVED_BUDGET
  PRIOR_YEAR_ACTUAL
  SUBMISSION_VERSION
  USER_DRAFT
  RETURN_REASON
  MANUAL_ADJUSTMENT
  QUERY_PREFERENCE
  FIELD_PREFERENCE
  PERIOD_VARIANCE
  AMOUNT_PERCENT_VARIANCE
}

enum DualControlAction {
  UNLOCK_BUDGET
  ROLE_CHANGE
  EXPORT_APPROVED_REPORT
  DELETE_AUDIT_RESTRICTED
}

enum DualControlStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  name              String
  role              Role
  // true for company-wide roles (finance / admin / auditor / read-only granted globally).
  // Department-scoped roles (BUDGET_OWNER / DEPARTMENT_EDITOR / DEPARTMENT_REVIEWER)
  // must instead be granted access via UserDepartmentScope rows.
  companyWide       Boolean   @default(false)
  isActive          Boolean   @default(true)
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  mustResetPassword Boolean   @default(false)
  // Reserved integration points for future company SSO / MFA (see SECURITY.md).
  ssoSubject        String?   @unique
  mfaEnabled        Boolean   @default(false)
  // Bumped by revokeAllSessions() (lib/auth/session.ts) whenever an admin
  // needs to force every existing login for this user to stop working
  // immediately - every JWT session cookie embeds the sessionVersion that
  // was current when it was issued, and getCurrentUser() rejects any
  // session whose embedded value no longer matches this column. This is
  // the ONLY revocation mechanism for an otherwise-stateless JWT session:
  // there is no server-side session table to delete rows from, so
  // "log this user out everywhere" has to work by making old tokens fail
  // validation rather than by destroying them.
  sessionVersion    Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  departmentScopes             UserDepartmentScope[]
  invitationsCreated           Invitation[]          @relation("InvitationCreatedBy")
  invitationsAccepted          Invitation[]          @relation("InvitationAcceptedBy")
  invitationsRevoked           Invitation[]          @relation("InvitationRevokedBy")
  preparedVersions             BudgetVersion[]       @relation("PreparedBy")
  submittedVersions            BudgetVersion[]       @relation("SubmittedBy")
  reviewedVersions             BudgetVersion[]       @relation("ReviewedBy")
  approvedVersions             BudgetVersion[]       @relation("ApprovedBy")
  preparationCompletedVersions BudgetVersion[]       @relation("PreparationCompletedBy")
  inputConfirmedLines          BudgetLine[]          @relation("BudgetLineInputConfirmedBy")
  auditLogs                    AuditLog[]
  memoryEntries                MemoryEntry[]
  aiConfirmedMemories          MemoryEntry[]         @relation("AiConfirmedBy")
  importBatches                ImportBatch[]
  passwordResets               PasswordResetToken[]
  dualControlRequests          DualControlRequest[]  @relation("DualControlRequestedBy")
  dualControlApprovals         DualControlRequest[]  @relation("DualControlApprovedBy")

  @@index([role])
}

// Explicit grant of a department-scoped user to one department. A user may
// hold scopes in multiple departments (e.g. covering for a peer) but never
// gains access outside these rows plus role-based company-wide access.
model UserDepartmentScope {
  id           String   @id @default(cuid())
  userId       String
  departmentId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
}

// One department-scoped invitation: "this email may claim access to this
// one department by proving possession of a token an admin generated".
// Deliberately department-scoped, not user-scoped - the same email can
// hold any number of PENDING/ACCEPTED invitations across different
// departments at once (see Stage 2B-3 三部門邀請登入 Pilot), each with its
// own independent token/expiry/attempt-count/status. Accepting one never
// touches another: a locked or expired invitation for department A must
// never block or auto-fail a still-valid invitation for department B.
//
// `id` is the ONLY thing that ever appears in the invitation URL
// (/invite/[id]) or the invitation email - it identifies WHICH invitation
// a token-entry attempt is against, but knowing it grants nothing by
// itself. The actual secret (a random 32-byte token, shown once to the
// admin who created it and delivered to the invitee out of band - see
// docs on the create-invitation response) is never stored in plaintext,
// never embedded in the URL, and never written to any log or AuditLog
// row - only `tokenHash` (sha256 of the real token) is persisted, mirroring
// PasswordResetToken's own tokenHash convention below.
model Invitation {
  id           String           @id @default(cuid())
  departmentId String
  email        String
  tokenHash    String           @unique
  status       InvitationStatus @default(PENDING)
  // Wrong-token submissions against this specific invitation. Reset is
  // never allowed once LOCKED - an admin must revoke and issue a fresh
  // invitation (see requirement: "超過後鎖定該邀請", not "解鎖該邀請").
  attemptCount Int              @default(0)
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?

  createdById      String
  acceptedByUserId String?
  revokedById      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdBy  User       @relation("InvitationCreatedBy", fields: [createdById], references: [id])
  acceptedBy User?      @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id])
  revokedBy  User?      @relation("InvitationRevokedBy", fields: [revokedById], references: [id])

  @@index([email])
  @@index([departmentId])
  @@index([status])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

// ---------------------------------------------------------------------------
// Master data: departments & chart of accounts
// ---------------------------------------------------------------------------

model Department {
  id       String    @id @default(cuid())
  code     String    @unique
  name     String
  class    DeptClass
  isActive Boolean   @default(true)
  notes    String?

  // Most recently known reference headcount for this department,
  // independent of any specific BudgetVersion - mirrors
  // Account.priorYearReferenceAmount (same rationale: a real, controlled
  // figure, never fabricated per-department, left null until actually
  // known). When set AND priorYearReferenceFiscalYear matches the fiscal
  // year immediately before the one being drafted, a newly created
  // BudgetVersion draft (see createBudgetVersionDraft) seeds both its
  // priorYearHeadcount (read-only prior-year reference) and initial
  // budgetYearHeadcount (the draft's own fiscal year, user-editable) from
  // this value instead of leaving them at 0/null.
  priorYearHeadcount           Int?
  // Which fiscal year priorYearHeadcount actually represents (e.g. 2025 for
  // a figure sourced from a "2025推移" column). A new draft for fiscal year
  // Y only uses priorYearHeadcount as its prior-year reference when this
  // equals exactly Y-1 - never reused across a year it doesn't match (that
  // would silently relabel an older year's figure as if it were Y-1's).
  // Null means "no confirmed reference year at all".
  priorYearReferenceFiscalYear Int?

  // true only for a department created by the Stage 2A preview-only
  // stress-seed endpoint (see src/lib/testdata). Never true for a real
  // department, including 財務管理處 - this is what lets that endpoint be
  // idempotent and lets any future cleanup tooling distinguish its rows
  // from real master data.
  isTestData Boolean @default(false)

  // Domestic vs. overseas site (see DomesticOverseas). Independent of
  // `class` - an overseas unit is still M/S/R/P per its real business
  // function (e.g. 20001 GWK and A0004 蘇州廠 are both class S). Sourced
  // from docs/data/stage2b1-department-manifest.json's domesticOrOverseas
  // field, never guessed from the name/code.
  domesticOrOverseas DomesticOverseas @default(DOMESTIC)

  // ERP code of this department's roll-up parent per
  // docs/data/stage2b1-department-manifest.json's rollupParentCode (e.g.
  // "17103" 資訊處 rolls up to "17003" 管理本部). Deliberately a plain code
  // string, not a foreign key to another Department row: most roll-up
  // parents (PARENT_ONLY in the manifest, e.g. 17003) are never themselves
  // created as Department rows in this system (they have no budget entry
  // point), so there is nothing for a real FK to reference. Used only for
  // read-side aggregation/display; see src/lib/reference/departmentRollups.ts
  // for the accompanying static code->name lookup. Null means no
  // intermediate roll-up (the department lists directly under the
  // company-wide authority table).
  rollupParentCode String?

  // true for every department created via the Stage 2B-2 full-roster
  // initializer (src/lib/masterdata/initializeBudgetOwnerDepartments.ts) -
  // i.e. every row in this table, by construction, since this system never
  // creates a Department row for a PARENT_ONLY/MERGED/INACTIVE/
  // NEEDS_CONFIRMATION code (those have no budget entry point). Kept as an
  // explicit column - rather than "presence in this table implies it" -
  // so a future stage that DOES need non-owner Department rows (e.g. for
  // org-chart display) has a real column to flip to false, without a
  // migration that changes the meaning of every existing row.
  isBudgetOwner Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userScopes     UserDepartmentScope[]
  budgetVersions BudgetVersion[]
  salaryDataRows SalaryDataSource[]
  memoryEntries  MemoryEntry[]
  invitations    Invitation[]

  @@index([class])
}

model Account {
  id             String                @id @default(cuid())
  code           String                @unique
  name           String
  majorCategory  DeptClass
  commonCategory AccountCommonCategory
  entryType      AccountEntryType
  formulaKey     String?
  isActive       Boolean               @default(true)

  // Which chart of accounts this row belongs to - see AccountCatalog's own
  // doc comment. The explicit, permanent signal for account SELECTION
  // (never sourceSeq, which only happens to correlate with catalog today
  // because seedDemoMasterData.ts is currently the only writer of
  // sourceSeq - see getBudgetAccountsForDepartment in
  // src/lib/budget/accountSelection.ts).
  catalog AccountCatalog @default(OFFICIAL)

  // True when `code` is a stand-in identifier assigned because the source
  // data (e.g. an imported spreadsheet) had no official chart-of-accounts
  // code yet - never to be presented or relied on as a confirmed official
  // account code. See sourceSeq/sourceRef for where the code came from.
  isProvisionalCode Boolean @default(false)
  // Unique (nullable - Postgres allows any number of NULLs in a unique
  // index) so DEMO seed upserts can target the stable Excel A欄 序號
  // instead of `code` itself, which is exactly the column that seed needs
  // to be able to change in place (see seedDemoMasterData.ts) - a real,
  // non-demo imported account simply leaves this null.
  sourceSeq         Int?    @unique
  sourceRef         String?

  // Most recently known prior-year reference amount for this account,
  // independent of any specific BudgetVersion. When set AND
  // priorYearReferenceFiscalYear matches the fiscal year immediately before
  // the one being drafted, a newly created BudgetVersion draft (see
  // createBudgetVersionDraft) seeds its BudgetLine's read-only prior-year
  // reference fields from this value instead of leaving them at 0/
  // "資料不全" - still never a fabricated figure, only ever set from a
  // real, controlled import.
  priorYearReferenceAmount     Decimal? @db.Decimal(18, 2)
  // Which fiscal year priorYearReferenceAmount actually represents (e.g.
  // 2025 for a figure sourced from a "2025推移" column in a spreadsheet
  // covering the 2026 budgeting cycle). A new draft for fiscal year Y only
  // uses priorYearReferenceAmount as its prior-year reference when this
  // equals exactly Y-1 - a draft for any other fiscal year must never reuse
  // it relabeled as if it were that year's reference; see
  // createBudgetVersionDraft. Null means "no confirmed reference year".
  priorYearReferenceFiscalYear Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  budgetLines BudgetLine[]

  @@index([majorCategory])
  @@index([entryType])
  @@index([catalog])
}

model FormulaDefinition {
  id            String    @id @default(cuid())
  key           String
  version       Int
  description   String
  // Structured, machine-evaluable expression definition (JSON). Kept as a
  // versioned, effective-dated record so historical budget runs remain
  // reproducible even after formulas change.
  expression    Json
  effectiveFrom DateTime
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  createdById   String
  createdAt     DateTime  @default(now())

  @@unique([key, version])
  @@index([key, isActive])
}

// Payroll basis used by FORMULA accounts (e.g. bonuses derived from base
// salary). If a department/year/month row is missing, dependent formula
// accounts must be treated as NOT_CONFIGURED, never silently 0.
model SalaryDataSource {
  id              String   @id @default(cuid())
  departmentId    String
  fiscalYear      Int
  month           Int
  totalBaseSalary Decimal  @db.Decimal(18, 2)
  employeeCount   Int
  isConfirmed     Boolean  @default(false)
  source          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@unique([departmentId, fiscalYear, month])
}

// ---------------------------------------------------------------------------
// Budget workflow
// ---------------------------------------------------------------------------

model BudgetVersion {
  id            String       @id @default(cuid())
  departmentId  String
  fiscalYear    Int
  versionNumber Int
  status        BudgetStatus @default(DRAFT)

  // Adjustment chain: an approved/locked version being adjusted spawns a new
  // version referencing it as parent. The parent is never overwritten.
  parentVersionId String?
  parentVersion   BudgetVersion?  @relation("AdjustmentChain", fields: [parentVersionId], references: [id])
  childVersions   BudgetVersion[] @relation("AdjustmentChain")

  preparedById  String?
  submittedById String?
  reviewedById  String?
  approvedById  String?

  submittedAt     DateTime?
  reviewStartedAt DateTime?
  returnedAt      DateTime?
  returnReason    String?
  approvedAt      DateTime?
  lockedAt        DateTime?
  rejectedAt      DateTime?
  rejectReason    String?

  adjustmentReason String?

  // 部門人數 (department headcount) - not an accounting line item, never an
  // Account/BudgetLine (see docs on DEMO_ACCOUNTS in demo/constants.ts for
  // why 序1「平均人數」is deliberately excluded from the chart of accounts)
  // and never included in any category subtotal or the 管理費用 grand
  // total. priorYearHeadcount is the read-only prior-year reference (fiscal
  // year = this version's fiscalYear - 1), seeded once at draft creation
  // from Department.priorYearHeadcount ONLY when
  // Department.priorYearReferenceFiscalYear actually matches fiscalYear-1
  // (see createBudgetVersionDraft) - null when no such confirmed reference
  // exists, never a stale/mismatched-year figure relabeled as if it were
  // fiscalYear-1's. Never editable through the regular budget-line API.
  // budgetYearHeadcount is this version's own fiscal-year figure the
  // preparer edits directly on this BudgetVersion (see
  // updateBudgetYearHeadcount) while the version is in an editable state,
  // subject to the exact same isEditable()/isLocked-style workflow gating
  // as every other budget figure.
  priorYearHeadcount  Int?
  budgetYearHeadcount Int  @default(0)

  // 最後一次編製日期 (last prepared date) - deliberately separate from
  // `updatedAt`, which also moves on every workflow/state transition
  // (submit, withdraw, review, approve, ...) and therefore cannot represent
  // "when did the preparer last actually change a figure". Set once at
  // draft creation, then bumped only by an actual content write that
  // changes a stored value - the 2026 amount/新員/編列依據 fields (see
  // updateDepartmentInputLine) or 2026 部門人數 (see
  // updateBudgetYearHeadcount) - and only when the new value differs from
  // what was already stored; opening the page, withdrawing a submission, or
  // submitting/resubmitting never touches it.
  lastPreparedAt DateTime

  // Set when the preparer explicitly confirms the department headcount
  // figure (budgetYearHeadcount) via updateBudgetYearHeadcount - never set
  // by seed/migration/import. Null means the current budgetYearHeadcount
  // (even if non-zero, e.g. seeded from Department.priorYearHeadcount) is
  // only a starting reference, not a user-confirmed value. Mirrors
  // BudgetLine.inputConfirmedAt's role for the per-line amount fields.
  headcountConfirmedAt DateTime?

  // Set only when the preparer explicitly runs "完成編製" (complete
  // preparation) and it passes the completeness gate (see
  // completePreparation in src/lib/budget/lineService.ts) - never inferred
  // from status alone. Distinguishes READY_TO_SUBMIT (this set, status
  // still DRAFT) from an ordinary in-progress DRAFT. Cleared on
  // withdraw/return per the documented reopen rules (see
  // completePreparation/reopenPreparation) - never left stale once content
  // changes again.
  preparationCompletedAt   DateTime?
  preparationCompletedById String?
  preparationCompletedBy   User?     @relation("PreparationCompletedBy", fields: [preparationCompletedById], references: [id])

  // true only for a DRAFT version created by the Stage 2A preview-only
  // stress-seed endpoint. Never true for a real department's budget
  // version, including 財務管理處's.
  isTestData Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  department  Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  preparedBy  User?      @relation("PreparedBy", fields: [preparedById], references: [id])
  submittedBy User?      @relation("SubmittedBy", fields: [submittedById], references: [id])
  reviewedBy  User?      @relation("ReviewedBy", fields: [reviewedById], references: [id])
  approvedBy  User?      @relation("ApprovedBy", fields: [approvedById], references: [id])

  lines BudgetLine[]

  @@unique([departmentId, fiscalYear, versionNumber])
  @@index([departmentId, fiscalYear])
  @@index([status])
}

model BudgetLine {
  id              String @id @default(cuid())
  budgetVersionId String
  accountId       String

  // 11-column template fields (docs/budget-system-spec-v0.4.md §1.4)
  priorPriorYearActual       Decimal  @db.Decimal(18, 2) // 20XX 實績
  priorYearOriginalBudget    Decimal  @db.Decimal(18, 2) // 20XX 目標
  currentYearProjection      Decimal? @db.Decimal(18, 2) // 20XX 推移 (null until computable)
  projectionIsComplete       Boolean  @default(false) // false = 資料不全，待確認
  nextYearTargetExcludingNew Decimal  @default(0) @db.Decimal(18, 2) // 20XX+1 目標不含新員
  nextYearNewHireBudget      Decimal  @default(0) @db.Decimal(18, 2) // 20XX+1 目標新員
  // system-computed, never directly editable by users:
  nextYearTotal              Decimal  @default(0) @db.Decimal(18, 2) // 合計(含新員)
  growthRateExcludingNew     Decimal? @db.Decimal(9, 4) // 不含新員成長率
  growthRateIncludingNew     Decimal? @db.Decimal(9, 4) // 含新員成長率

  entryTypeSnapshot AccountEntryType
  formulaStatus     FormulaStatus    @default(NOT_APPLICABLE)
  isLocked          Boolean          @default(false) // true for NOT_BUDGETED / FORMULA lines

  // 說明／編列依據 - free-text basis for the preparer's 2026 figure. Editable
  // by the same DEPARTMENT_INPUT rules as the amount fields (see
  // updateDepartmentInputLine); never auto-filled from any import.
  justification String?

  // Explicit "the preparer actually entered/confirmed this line" marker -
  // the authoritative signal for progress tracking, replacing the old
  // createdAt===updatedAt heuristic (see docs/stage2b1-department-
  // reconciliation.md §7.2 for why that heuristic is unreliable: any batch
  // UPDATE that happens to touch updatedAt would misclassify an untouched
  // seeded row as "entered"). Set only inside updateDepartmentInputLine,
  // only when hasContentChanged is true - never by seed, migration, or any
  // batch-fix script. Null means untouched (whether the stored amount is
  // 0 from @default(0) or otherwise); non-null (with inputConfirmedById)
  // means the user explicitly entered/confirmed this line, including an
  // explicit 0.
  inputConfirmedAt   DateTime?
  inputConfirmedById String?
  inputConfirmedBy   User?     @relation("BudgetLineInputConfirmedBy", fields: [inputConfirmedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  budgetVersion  BudgetVersion             @relation(fields: [budgetVersionId], references: [id], onDelete: Cascade)
  account        Account                   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  monthlyActuals BudgetLineMonthlyActual[]

  @@unique([budgetVersionId, accountId])
  @@index([formulaStatus])
  @@index([inputConfirmedAt])
}

model BudgetLineMonthlyActual {
  id           String   @id @default(cuid())
  budgetLineId String
  year         Int
  month        Int
  amount       Decimal? @db.Decimal(18, 2)
  isMissing    Boolean  @default(false)
  source       String?
  createdAt    DateTime @default(now())

  budgetLine BudgetLine @relation(fields: [budgetLineId], references: [id], onDelete: Cascade)

  @@unique([budgetLineId, year, month])
}

model ConsistencyCheckRun {
  id              String   @id @default(cuid())
  fiscalYear      Int
  departmentTotal Decimal  @db.Decimal(18, 2)
  accountTotal    Decimal  @db.Decimal(18, 2)
  difference      Decimal  @db.Decimal(18, 2)
  passed          Boolean
  detail          Json
  runByUserId     String?
  createdAt       DateTime @default(now())

  @@index([fiscalYear])
}

// ---------------------------------------------------------------------------
// Import batches (accounts / departments / users / budget lines)
// ---------------------------------------------------------------------------

model ImportBatch {
  id              String            @id @default(cuid())
  entityType      ImportEntityType
  fileName        String
  fileHash        String
  templateVersion String
  fiscalYear      Int?
  uploadedById    String
  status          ImportBatchStatus @default(PENDING)
  totalRows       Int               @default(0)
  successRows     Int               @default(0)
  errorCount      Int               @default(0)
  errorReport     Json?
  committedAt     DateTime?
  createdAt       DateTime          @default(now())

  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@unique([entityType, fileHash])
  @@index([entityType, status])
}

// ---------------------------------------------------------------------------
// Audit trail (append-only)
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  reason      String?
  beforeData  Json?
  afterData   Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Business memory (structured, scoped, traceable - not chat-style memory)
// ---------------------------------------------------------------------------

model MemoryEntry {
  id                String     @id @default(cuid())
  type              MemoryType
  scopeDepartmentId String? // null = company-wide scope (finance/admin only)
  fiscalYear        Int?
  source            String // e.g. "system:budget-close", "user:<id>", "import:<batchId>"
  payload           Json

  createdById String
  createdAt   DateTime @default(now())

  // Personal-preference type memories may be deleted by their owner.
  // Audit/business-record types (approved budgets, return reasons, submission
  // history, manual adjustments) are never user-deletable.
  isUserDeletable Boolean   @default(false)
  deletedAt       DateTime?

  // AI-suggested memories must be explicitly confirmed by a human before any
  // downstream feature may treat them as authoritative draft input. They are
  // never used to overwrite an official budget directly.
  aiSuggested     Boolean   @default(false)
  aiConfirmedById String?
  aiConfirmedAt   DateTime?
  overrideReason  String? // required when a user overrides an AI suggestion

  createdBy     User        @relation(fields: [createdById], references: [id])
  aiConfirmedBy User?       @relation("AiConfirmedBy", fields: [aiConfirmedById], references: [id])
  department    Department? @relation(fields: [scopeDepartmentId], references: [id])

  @@index([type, scopeDepartmentId, fiscalYear])
  @@index([createdById])
}

// ---------------------------------------------------------------------------
// Dual control / second-approver for high-risk operations
// ---------------------------------------------------------------------------

model DualControlRequest {
  id               String            @id @default(cuid())
  action           DualControlAction
  targetEntityType String
  targetEntityId   String
  reason           String
  payload          Json?
  status           DualControlStatus @default(PENDING)

  requestedById String
  approvedById  String?
  approvedAt    DateTime?
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())

  requestedBy User  @relation("DualControlRequestedBy", fields: [requestedById], references: [id])
  approvedBy  User? @relation("DualControlApprovedBy", fields: [approvedById], references: [id])

  @@index([status])
  @@index([targetEntityType, targetEntityId])
}
