# Copy to .env.local for local development. Never commit real values.
# Full setup instructions: see NEON_SETUP.md and VERCEL_DEPLOYMENT.md.

# Neon PostgreSQL - POOLED (PgBouncer) connection string, used by the app at
# runtime. Get this from the Neon console: Project -> Connect -> "Pooled
# connection". Must include ?sslmode=require&pgbouncer=true.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true"

# Neon PostgreSQL - DIRECT (unpooled) connection string, used only by
# Prisma Migrate (schema migrations require a direct connection, not
# PgBouncer transaction-mode pooling). Get this from the Neon console:
# Project -> Connect -> "Direct connection".
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Random secret used to sign session cookies (JWT, HS256). Generate with:
#   openssl rand -base64 48
# Minimum 32 characters. Rotating this invalidates all active sessions.
SESSION_SECRET="replace-with-a-random-32+-character-secret"

# development | test | production
NODE_ENV="development"

# Public base URL of the deployment, used for building absolute links in
# emails / redirects. Example: https://budget.example.com
APP_BASE_URL=""

# --- One-time operational bootstrap (see OPERATIONS.md) -------------------
# Only used when running `npm run bootstrap:admin` manually. Never set these
# in Vercel/CI environment variables - export them only in your local shell
# for the single command invocation, then unset.
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="choose-a-strong-password"
# ADMIN_NAME="System Administrator"
