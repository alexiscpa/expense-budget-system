# Copy to .env.local for local development. Never commit real values.
# Full setup instructions: see NEON_SETUP.md and VERCEL_DEPLOYMENT.md.

# Neon PostgreSQL - POOLED (PgBouncer) connection string, used by the app at
# runtime. Get this from the Neon console: Project -> Connect -> "Pooled
# connection". Must include ?sslmode=require&pgbouncer=true.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true"

# Neon PostgreSQL - DIRECT (unpooled) connection string, used only by
# Prisma Migrate (schema migrations require a direct connection, not
# PgBouncer transaction-mode pooling). Get this from the Neon console:
# Project -> Connect -> "Direct connection".
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Random secret used to sign session cookies (JWT, HS256). Generate with:
#   openssl rand -base64 48
# Minimum 32 characters. Rotating this invalidates all active sessions.
SESSION_SECRET="replace-with-a-random-32+-character-secret"

# development | test | production
#
# Deliberately left UNSET here (not defaulted to "development"): Next.js
# loads .env.local for every command, including `next build`/`next start`,
# and a value baked in here would silently override the "production" value
# Next itself sets for those commands - this actually happened during Stage
# 2A branch integration (see git history): `npm run build` failed with
# "<Html> should not be imported outside of pages/_document" and a null-
# dispatcher `useContext` crash while pre-rendering /404, /500, and several
# real app pages, because the development-mode React DOM server renderer
# was being used for what should have been a production build. Only set
# this explicitly if you specifically need to override it for local `npm
# run dev`/`npm test` (which already set their own value - see
# vitest.config.ts) - never uncomment it before `npm run build`.
# NODE_ENV="development"

# Public base URL of the deployment, used for building absolute links in
# emails / redirects. Example: https://budget.example.com
APP_BASE_URL=""

# --- Preview-only "Demo 測試環境" no-login bypass (P0 上線阻擋項目 / go-live blocker) ---
# AUTH_DISABLED=true only takes effect when Vercel's own VERCEL_ENV is
# exactly "preview" (auto-injected by Vercel, never set locally). It has NO
# effect in Production, and no effect in local dev either - there is no
# override flag of any kind. Leave unset/false everywhere by default.
#
# DO NOT set this in the Vercel "Production" environment variables. Only set
# it (to "true") in the Vercel "Preview" environment variables, and only if
# the Preview environment's DATABASE_URL/DIRECT_URL point at a dedicated
# Neon test/preview branch - never the production branch (see NEON_SETUP.md
# and VERCEL_DEPLOYMENT.md §9). Enabling this is a P0 go-live blocker item:
# confirm it is unset (or "false") in Production before every release.
#
# This app does NOT define/read an "ALLOW_PRODUCTION_AUTH_BYPASS" (or any
# other) second override variable - there is intentionally no way to
# re-enable this bypass in Production, with or without an extra flag.
#
# Test mode must never be used to enter real personnel, salary, budget, or
# any other company-sensitive data - see the on-screen "Demo 測試環境，禁止輸入
# 正式資料" banner shown whenever this bypass is active.
AUTH_DISABLED="false"

# --- One-time operational bootstrap (see OPERATIONS.md) -------------------
# Only used when running `npm run bootstrap:admin` manually. Never set these
# in Vercel/CI environment variables - export them only in your local shell
# for the single command invocation, then unset.
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="choose-a-strong-password"
# ADMIN_NAME="System Administrator"
